+static void vub_reset(VirtIODevice *vdev)
+{
+    VHostUserBase *vub = VHOST_USER_BASE(vdev);
+    int ret;
+
+    /* set_status has synchronously stopped the queues before this callback. */
+    if (vub->connected) {
+        ret = vhost_reset_device(&vub->vhost_dev);
+        if (ret < 0 && ret != -ENOSYS) {
+            virtio_error(vdev, "vhost-user reset failed: %d", ret);
+        }
+    }
+}
